# Copy to `.env` (gitignored) and fill in the values you use.
# Never commit real secrets.

# --- Bare-metal (official deploy: systemd opencode-web.service) --------------
# The web UI password lives in /root/.config/opencode/service.json (generated and
# kept by OpenCode; `opencode service get password` prints it). Traefik injects
# the basic auth on ai.yourdomain.com, so no login is needed on the LAN.
# (Legacy: OPENCODE_PASSWORD= was the V1 standalone-serve password; no longer used.)

# Provider key, conventional name <PROVIDER>_API_KEY.
# The bare-metal deploy injects it into /root/.config/opencode/opencode.json at
# install time, or use `opencode auth login deepseek` instead. Never committed.
DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Legacy Docker only (deprecated) -----------------------------------------
# The container deployment is retired; these variables are kept for reference.
# Bare-metal always listens on port 4096 and ignores PORT.
# PORT=4096
# Host path mounted as /workspace in the legacy container.
# WORKSPACE_PATH=./workspace
